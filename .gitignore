# --- copyrighted: the game file and everything read from it (each player uses their own cartridge) ---
*.gba
*.GBA
*.sav
data/imported/
# made from data/ by tools/make_pack.py at build time
project/bundle/gamedata.pack
# your own songs / sounds are not part of the game
data/music/*.ogg
data/music/*.mp3
data/sounds/

# --- the release signing key: never public ---
keys/
*.keystore
*.jks
keystore_password.txt

# --- build outputs and the downloaded Godot export templates ---
out/
templates/
*.apk
*.aab
*.idsig
importer/godot_export
importer/android/
importer/source/godot_export
importer/source/build/

# --- Godot editor cache ---
project/.godot/
project/android/

# --- macOS / exFAT clutter ---
._*
.DS_Store

# this machine's tool paths
tools/local.env

# --- GLOBAL MULTIPLAYER: the live lobby list stays private ---
lobby/wrangler.private.toml
lobby/.cloudflare_token
lobby/.wrangler/
lobby/node_modules/
project/lobby_server.txt

# ZeroTier library binary (built from libzt; see README)
android_custom/*.aar

# art taken from the game file (copyrighted) - never in the repo
art_work/
