; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

boot_splash/show_image=true
boot_splash/image="res://art/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/quit_on_go_back=false
boot_splash/bg_color=Color(0, 0, 0, 1)

config/name="Legacy of Goku II - Co-op (Godot)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")
run/max_fps=60
config/quit_on_go_back=false
config/icon="res://art/icon.png"

[autoload]

Assets="*res://scripts/assets.gd"
Mods="*res://scripts/mods.gd"
Game="*res://scripts/game.gd"
Online="*res://scripts/online.gd"
Content="*res://scripts/content.gd"
Sfx="*res://scripts/sfx.gd"
Music="*res://scripts/music.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/handheld/orientation=4

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":0,"pressure":0.0,"pressed":true,"script":null)
